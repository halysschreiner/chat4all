{
    "name": "chat4all/websocket-worker",
    "description": "WebSocket Worker para Chat4All - Notificações em tempo real",
    "type": "project",
    "require": {
        "php": "^8.1",
        "cboden/ratchet": "^0.4.4",
        "react/event-loop": "^1.4",
        "predis/predis": "^2.2",
        "monolog/monolog": "^3.5",
        "ramsey/uuid": "^4.7",
        "firebase/php-jwt": "^6.10",
        "clue/redis-react": "^2.6",
        "ext-rdkafka": "*"
    },
    "autoload": {
        "psr-4": {
            "Chat4All\\WebSocket\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}