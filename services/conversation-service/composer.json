{
    "name": "chat4all/conversation-service",
    "description": "Conversation Service - gRPC Server for Conversations",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-grpc": "*",
        "grpc/grpc": "^1.57",
        "google/protobuf": "^3.25"
    },
    "autoload": {
        "psr-4": {
            "Chat4All\\ConversationService\\": "src/",
            "Conversation\\": "generated/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}