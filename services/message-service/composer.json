{
    "name": "chat4all/message-service",
    "description": "Message Service - gRPC Server for Messages",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-grpc": "*",
        "grpc/grpc": "^1.57",
        "google/protobuf": "^3.25"
    },
    "autoload": {
        "psr-4": {
            "Chat4All\\MessageService\\": "src/",
            "Message\\": "generated/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}