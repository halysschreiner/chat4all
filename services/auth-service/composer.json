{
    "name": "chat4all/auth-service",
    "description": "Auth Service - gRPC Server for Authentication",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-grpc": "*",
        "grpc/grpc": "^1.57",
        "google/protobuf": "^3.25"
    },
    "autoload": {
        "psr-4": {
            "Chat4All\\AuthService\\": "src/",
            "Auth\\": "generated/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}